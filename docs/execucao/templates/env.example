# Valores FICTÍCIOS para o ambiente local (docker compose). Nunca use valores reais aqui.
NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://<svc>_svc:change-me@localhost:5432/fiapx?schema=<schema>&connection_limit=5&sslmode=disable
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=<svc>
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=fiapx-api
JWKS_URL=http://localhost:3001/.well-known/jwks.json
TRUST_GATEWAY_IP=false
# ADAPTAR: variáveis específicas do serviço (spec B10)
