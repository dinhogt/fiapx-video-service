      "type": "text",
      "title": "FIAP X: jornada do vídeo",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Dashboard provisionado (ADR-011). Métricas de negócio (`videos_*`, `outbox_*`) e traces OTel passam a aparecer quando os serviços sobem (F2–F5)."
      }
    },
    {
      "type": "timeseries",
      "title": "Vídeos processados (por status)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(videos_processed_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duração do processamento",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(video_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox pendente",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "outbox_pending_total",
          "legendFormat": "pending"
        },
        {
          "expr": "outbox_oldest_pending_seconds",
          "legendFormat": "oldest_seconds"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logs (Loki)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{env=\"local\"}"
        }
      ]
    }
  ],
